# PesaIQ — environment template.
# Copy to `.env` and fill in locally. NEVER commit `.env`.
#
# Stage 1 requires NO keys: parsing is entirely on-device and the AI layer is an
# interface with no provider wired in. These are placeholders for later stages.

# Optional AI fallback (OFF by default, Stage 1 does not read this).
# EXPO_PUBLIC_AI_PROVIDER=
# AI_API_KEY=
